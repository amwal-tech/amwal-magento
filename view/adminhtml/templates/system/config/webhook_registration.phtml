                    ✓ <?= $block->escapeHtml(__('Stored (RSA-PSS SHA-256)')) ?>
                </span>
            </div>
            <div class="amwal-webhook-status__row" id="amwal-webhook-env-row" style="<?= !empty($storedKeyType) ? '' : 'display:none;' ?>">
                <span class="amwal-webhook-status__label"><?= $block->escapeHtml(__('Key Environment:')) ?></span>
                <span class="amwal-webhook-status__value" id="amwal-webhook-env-status">
                    <?php if (!empty($storedKeyType)): ?>
                        <?php $envMatches = ($storedKeyType === $storeEnv); ?>
                        <span class="amwal-event-pill <?= $envMatches ? '' : 'amwal-event-pill--warn' ?>">
