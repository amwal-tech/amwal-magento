                        </span>
                        <?php if ($envMatches): ?>
                            <span class="amwal-webhook-status__value--ok">(<?= $block->escapeHtml(__('Matches Store Mode')) ?>)</span>
                        <?php else: ?>
                            <span class="amwal-webhook-status__value--warn">(<?= $block->escapeHtml(__('Store is set to %1', ucfirst($storeEnv))) ?>)</span>
                        <?php endif; ?>
                    <?php endif; ?>
                </span>
            </div>
            <div class="amwal-webhook-status__row" id="amwal-webhook-events-row" style="<?= !empty($storedEvents) ? '' : 'display:none;' ?>">
                <span class="amwal-webhook-status__label"><?= $block->escapeHtml(__('Subscribed Events:')) ?></span>
                <span class="amwal-webhook-status__value" id="amwal-webhook-events-list">
                    <?php foreach ($storedEvents as $ev): ?>
                        <span class="amwal-event-pill">✓ <?= $block->escapeHtml($ev) ?></span>
                    <?php endforeach; ?>
                </span>
            </div>
            <div class="amwal-webhook-status__row" id="amwal-webhook-url-status-row" style="display:none;">
                <span class="amwal-webhook-status__label"><?= $block->escapeHtml(__('Endpoint Match:')) ?></span>
                <span class="amwal-webhook-status__value" id="amwal-webhook-url-status"></span>
            </div>
        </div>

        <div class="amwal-webhook-status__hint" id="amwal-webhook-hint" style="<?= $isRegistered ? 'display:none;' : '' ?>">
            <ol style="margin: 0; padding-left: 18px; line-height: 1.6;">
                <li><?= $block->escapeHtml(__('Copy your store\'s Webhook Endpoint URL above.')) ?></li>
                <li><?= __('Go to <a href="https://merchant.sa.amwal.tech/" target="_blank">Amwal Merchant Portal</a> &gt; <strong>Settings</strong> &gt; <strong>Webhook Sandbox</strong> or <strong>Webhook Production</strong>.') ?></li>
                <li><?= $block->escapeHtml(__('Paste your Webhook URL, click Save, then click "Generate Key" to create your RSA keypair.')) ?></li>
                <li><?= $block->escapeHtml(__('Paste the generated Public Key into the Webhook Public Key field above and click "Validate & Sync Webhook".')) ?></li>
            </ol>
        </div>

        <button type="button" class="action-primary amwal-webhook-btn <?= $isRegistered ? 'amwal-webhook-btn--secondary' : '' ?>" id="<?= $block->getHtmlId() ?>_button">
            <span id="amwal-webhook-btn-text"><?= $block->escapeHtml($isRegistered ? __('Validate & Sync Webhook') : __('Validate & Sync Webhook')) ?></span>
        </button>
    </div>

    <div id="amwal-webhook-result" style="margin-top: 12px; display: none;"></div>
