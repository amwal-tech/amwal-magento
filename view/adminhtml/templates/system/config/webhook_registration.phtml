<script type="text/javascript">
    require(['jquery', 'mage/translate'], function($, $t) {
        $(document).ready(function() {
            $('#<?= $block->getHtmlId() ?>_button').click(function() {
                var $btn = $(this);
                var $result = $('#amwal-webhook-result');

                // Get public key input value
                var $keyInput = $('[name="groups[amwal_payments][groups][webhook][fields][public_key][value]"]');
                if (!$keyInput.length) {
                    $keyInput = $('#payment_amwal_payments_webhook_public_key');
                }
                var publicKey = $keyInput.length ? $keyInput.val().trim() : '';
                var formKey = $('input[name="form_key"]').val();
                var scope = '<?= $block->escapeJs($scope ?? 'default') ?>';
                var scopeId = '<?= (int) ($scopeId ?? 0) ?>';

                // Check URL params if not in scope data
                var urlParams = new URLSearchParams(window.location.search);
                if (urlParams.get('website')) {
                    scope = 'websites';
                    scopeId = urlParams.get('website');
                } else if (urlParams.get('store')) {
                    scope = 'stores';
                    scopeId = urlParams.get('store');
                }

                // Loading state
                $btn.attr('disabled', true);
                $result.html('<div class="message message-notice">' + $t('Validating key & synchronizing with Amwal API…') + '</div>').show();

                $.ajax({
                    url: '<?= $block->getAjaxUrl() ?>',
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        public_key: publicKey,
                        scope: scope,
                        scope_id: scopeId,
                        form_key: formKey
                    },
                    success: function(response) {
                        if (response.success) {
                            var alertClass = (response.warnings && response.warnings.length) ? 'message-warning' : 'message-success';
                            var alertHtml = '<div class="message ' + alertClass + '"><strong>' + (response.message || $t('Webhook synchronized with Amwal successfully!')) + '</strong>';

                            if (response.warnings && response.warnings.length) {
                                alertHtml += '<ul style="margin: 6px 0 0 16px; padding: 0;">';
                                response.warnings.forEach(function(w) {
                                    alertHtml += '<li>' + $('<div>').text(w).html() + '</li>';
                                });
                                alertHtml += '</ul>';
                            }
                            alertHtml += '</div>';
                            $result.html(alertHtml).show();

                            // Update UI state dynamically
                            $('#amwal-webhook-status-card')
                                .removeClass('amwal-webhook-status--unregistered')
                                .addClass('amwal-webhook-status--registered');
                            $('#amwal-webhook-badge')
                                .removeClass('amwal-webhook-status__badge--pending');
                            $('#amwal-webhook-icon').text('✓');
                            $('#amwal-webhook-text').text($t('Webhook Synchronized & Verified'));
                            $('#amwal-webhook-hint').hide();
                            $('#amwal-webhook-details').show();

                            if (response.fingerprint) {
                                $('#amwal-webhook-fingerprint').text(response.fingerprint);
                            }

                            // Update textarea with normalized PEM format
                            if (response.formatted_public_key && $keyInput.length) {
                                $keyInput.val(response.formatted_public_key);
                            }

                            // Render signature key status
                            if (response.key_active === false) {
                                $('#amwal-webhook-key-status')
                                    .removeClass('amwal-webhook-status__value--ok')
                                    .addClass('amwal-webhook-status__value--warn')
                                    .html('⚠ ' + $t('Key Inactive on Amwal'));
                            } else {
                                $('#amwal-webhook-key-status')
                                    .removeClass('amwal-webhook-status__value--warn')
                                    .addClass('amwal-webhook-status__value--ok')
                                    .html('✓ ' + $t('Stored (RSA-PSS SHA-256) - Active'));
                            }

                            // Render key environment (production / sandbox)
                            if (response.key_type) {
                                var envHtml = '';
                                if (response.env_matches) {
                                    envHtml = '<span class="amwal-event-pill">✓ ' + $('<div>').text(response.key_type.toUpperCase()).html() + '</span> ' +
                                              '<span class="amwal-webhook-status__value--ok">(' + $t('Matches Store Mode') + ')</span>';
                                } else {
                                    envHtml = '<span class="amwal-event-pill amwal-event-pill--warn">⚠ ' + $('<div>').text(response.key_type.toUpperCase()).html() + '</span> ' +
                                              '<span class="amwal-webhook-status__value--warn">(' + $t('Store is configured for ') + $('<div>').text(response.store_env).html() + ')</span>';
                                }
                                $('#amwal-webhook-env-status').html(envHtml);
                                $('#amwal-webhook-env-row').show();
                            }

                            // Render synced events pills
                            if (response.events && response.events.length) {
                                var pillsHtml = '';
                                response.events.forEach(function(ev) {
                                    pillsHtml += '<span class="amwal-event-pill">✓ ' + $('<div>').text(ev).html() + '</span> ';
                                });
                                if (!response.has_order_success) {
                                    pillsHtml += '<span class="amwal-event-pill amwal-event-pill--warn">⚠ ' + $t('order.success missing') + '</span> ';
                                }
                                $('#amwal-webhook-events-list').html(pillsHtml);
                                $('#amwal-webhook-events-row').show();
                            } else {
                                $('#amwal-webhook-events-list').html('<span class="amwal-event-pill amwal-event-pill--warn">⚠ ' + $t('No events selected on Amwal') + '</span>');
                                $('#amwal-webhook-events-row').show();
                            }

                            // Render endpoint match & active status
                            if (response.endpoint_url) {
                                var urlStatusHtml = '';
                                if (response.url_matches) {
                                    urlStatusHtml = '<span class="amwal-webhook-status__value--ok">✓ ' + $t('Matches Store Endpoint') + ' (' + $('<div>').text(response.endpoint_url).html() + ')</span>';
                                } else {
                                    urlStatusHtml = '<span class="amwal-webhook-status__value--warn">⚠ ' + $t('Amwal URL: ') + $('<div>').text(response.endpoint_url).html() + ' ≠ ' + $t('Store: ') + $('<div>').text(response.expected_endpoint_url || '').html() + '</span>';
                                }
                                if (response.endpoint_active === false) {
                                    urlStatusHtml += ' <span class="amwal-event-pill amwal-event-pill--warn">⚠ ' + $t('Endpoint Inactive') + '</span>';
                                }
                                $('#amwal-webhook-url-status').html(urlStatusHtml);
                                $('#amwal-webhook-url-status-row').show();
                            }

                            $('#amwal-webhook-btn-text').text($t('Validate & Sync Webhook'));
                            $btn.addClass('amwal-webhook-btn--secondary');
                        } else {
                            $result.html(
                                '<div class="message message-error">' +
                                $t('Validation failed: ') + response.message +
                                '</div>'
                            ).show();
                        }
                    },
                    error: function() {
                        $result.html(
                            '<div class="message message-error">' +
                            $t('An error occurred while validating the key. Please check system logs.') +
                            '</div>'
                        ).show();
                    },
                    complete: function() {
                        $btn.attr('disabled', false);
                    }
                });
            });
        });
    });
</script>
